# HTTP / Socket.IO
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*
# SQLite file (use :memory: for ephemeral runs)
DATABASE_PATH=./asta-legends.db
# base of invite links shown to users
PUBLIC_URL=astalegends://join

# AI player generator (optional). Without credentials the offline generator is used.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
AI_ENABLED=true

# Expo push notifications for offline users
EXPO_PUSH_ENABLED=true
